{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ],
      "env": [
        "NODE_ENV",
        "APP_NAME",
        "APP_HOST",
        "PORT",
        "SWAGGER_ENABLED",
        "DATABASE_URL",
        "JWT_ACCESS_SECRET",
        "JWT_ACCESS_EXPIRES_IN"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "outputs": []
    }
  }
}