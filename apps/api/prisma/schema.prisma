generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  SALE
}

enum RoomStatus {
  VACANT
  OCCUPIED
  RESERVED
  CHECKOUT_SOON
  MAINTENANCE
}

enum SaleContractStatus {
  ACTIVE
  COMPLETED
  CANCELED
}

enum CommissionStatus {
  UNPAID
  PAID
  CANCELED
}

enum CustomerStatus {
  RENTING
  ENDED
  CANCELED
}

enum CustomerDocumentType {
  PASSPORT
  ID_CARD
  VISA
  OTHER
}

enum LeaseContractStatus {
  RESERVED
  ACTIVE
  ENDED
  CANCELED
}

enum LeaseContractChangeAction {
  CREATED
  UPDATED
  EXTENDED
  ENDED_EARLY
  CANCELED
  FILE_ADDED
}

model User {
  id                              String                  @id @default(uuid())
  username                        String                  @unique
  email                           String                  @unique
  fullName                        String
  passwordHash                    String
  role                            UserRole                @default(STAFF)
  apartmentId                     String?
  apartment                       Apartment?              @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  isActive                        Boolean                 @default(true)
  lastLoginAt                     DateTime?
  createdAt                       DateTime                @default(now())
  updatedAt                       DateTime                @updatedAt
  meterReadings                   MeterReading[]
  saleProfile                     SaleProfile?
  confirmedSaleCommissionPayments SaleCommissionPayment[] @relation("SaleCommissionPaymentConfirmedBy")
  leaseContractChangeLogs         LeaseContractChangeLog[] @relation("LeaseContractChangeChangedBy")

  @@index([apartmentId])
}

model Apartment {
  id            String         @id @default(uuid())
  shortId       String?        @unique
  name          String
  address       String?
  note          String?
  timezone      String         @default("Asia/Bangkok")
  rooms         Room[]
  users         User[]
  customers     Customer[]
  leaseContracts LeaseContract[]
  saleContracts SaleContract[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Room {
  id            String         @id @default(uuid())
  shortId       String?        @unique
  apartmentId   String
  code          String
  floor         String?
  area          Decimal?       @db.Decimal(10, 2)
  monthlyRent   Decimal        @db.Decimal(10, 2)
  description   String?
  amenities     String[]       @default([])
  imageUrls     String[]       @default([])
  status        RoomStatus     @default(VACANT)
  note          String?
  apartment     Apartment      @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  meterReadings MeterReading[]
  leaseContracts LeaseContract[]
  saleContracts SaleContract[]
  currentCustomers Customer[]   @relation("CustomerCurrentRoom")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([apartmentId, code])
}

model Customer {
  id             String             @id @default(uuid())
  apartmentId    String
  currentRoomId  String?
  fullName       String
  dateOfBirth    DateTime?
  phoneNumber    String
  email          String?
  nationality    String?
  identityNumber String?
  passportNumber String?
  visaNumber     String?
  status         CustomerStatus     @default(ENDED)
  note           String?
  apartment      Apartment          @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  currentRoom    Room?              @relation("CustomerCurrentRoom", fields: [currentRoomId], references: [id], onDelete: SetNull)
  documents      CustomerDocument[]
  leaseContracts LeaseContract[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([apartmentId])
  @@index([currentRoomId])
  @@index([fullName])
  @@index([phoneNumber])
  @@index([identityNumber])
  @@index([passportNumber])
  @@index([status])
}

model CustomerDocument {
  id         String               @id @default(uuid())
  customerId String
  type       CustomerDocumentType
  fileName   String?
  fileUrl    String
  mimeType   String?
  size       Int?
  note       String?
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([customerId])
  @@index([type])
}

model MeterReading {
  id                   String   @id @default(uuid())
  roomId               String
  periodStart          DateTime
  periodEnd            DateTime
  electricityStart     Decimal  @db.Decimal(10, 2)
  electricityEnd       Decimal  @db.Decimal(10, 2)
  electricityUsage     Decimal  @db.Decimal(10, 2)
  electricityUnitPrice Decimal  @db.Decimal(10, 2)
  waterStart           Decimal  @db.Decimal(10, 2)
  waterEnd             Decimal  @db.Decimal(10, 2)
  waterUsage           Decimal  @db.Decimal(10, 2)
  waterUnitPrice       Decimal  @db.Decimal(10, 2)
  totalAmount          Decimal  @db.Decimal(10, 2)
  recordedById         String?
  note                 String?
  room                 Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  recordedBy           User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([roomId, periodStart, periodEnd])
  @@index([roomId, periodStart])
  @@index([recordedById])
}

model SaleProfile {
  id                 String                  @id @default(uuid())
  userId             String?                 @unique
  fullName           String
  phoneNumber        String
  bankAccountNumber  String
  bankName           String
  bankCode           String?
  note               String?
  isActive           Boolean                 @default(true)
  user               User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  contracts          SaleContract[]
  leaseContracts     LeaseContract[]
  commissionPayments SaleCommissionPayment[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([fullName])
  @@index([phoneNumber])
}

model SaleContract {
  id               String                      @id @default(uuid())
  contractCode     String                      @unique
  saleId           String
  apartmentId      String?
  roomId           String?
  customerName     String
  customerPhone    String?
  startDate        DateTime
  endDate          DateTime?
  contractValue    Decimal                     @db.Decimal(12, 2)
  commissionAmount Decimal                     @db.Decimal(12, 2)
  contractStatus   SaleContractStatus          @default(ACTIVE)
  commissionStatus CommissionStatus            @default(UNPAID)
  commissionPaidAt DateTime?
  note             String?
  sale             SaleProfile                 @relation(fields: [saleId], references: [id], onDelete: Restrict)
  apartment        Apartment?                  @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  room             Room?                       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  paymentItems     SaleCommissionPaymentItem[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([saleId])
  @@index([apartmentId])
  @@index([roomId])
  @@index([startDate])
  @@index([contractStatus])
  @@index([commissionStatus])
}

model SaleCommissionPayment {
  id             String                      @id @default(uuid())
  saleId         String
  totalAmount    Decimal                     @db.Decimal(12, 2)
  paymentQrUrl   String?
  paymentContent String
  confirmedById  String?
  paidAt         DateTime                    @default(now())
  note           String?
  sale           SaleProfile                 @relation(fields: [saleId], references: [id], onDelete: Restrict)
  confirmedBy    User?                       @relation("SaleCommissionPaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  items          SaleCommissionPaymentItem[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([saleId])
  @@index([confirmedById])
  @@index([paidAt])
}

model SaleCommissionPaymentItem {
  paymentId      String
  saleContractId String
  amount         Decimal               @db.Decimal(12, 2)
  payment        SaleCommissionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  saleContract   SaleContract          @relation(fields: [saleContractId], references: [id], onDelete: Restrict)

  @@id([paymentId, saleContractId])
  @@unique([saleContractId])
}

model LeaseContract {
  id                String                      @id @default(uuid())
  contractCode      String                      @unique
  apartmentId       String
  roomId            String
  customerId        String
  saleProfileId     String?
  startDate         DateTime
  endDate           DateTime
  rentDurationMonths Int?
  monthlyRent       Decimal                     @db.Decimal(12, 2)
  depositAmount     Decimal                     @default(0) @db.Decimal(12, 2)
  terms             String?
  commissionAmount  Decimal?                    @db.Decimal(12, 2)
  status            LeaseContractStatus         @default(RESERVED)
  note              String?
  apartment         Apartment                   @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  room              Room                        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  customer          Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  saleProfile       SaleProfile?                @relation(fields: [saleProfileId], references: [id], onDelete: SetNull)
  files             LeaseContractFile[]
  changeLogs        LeaseContractChangeLog[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([apartmentId])
  @@index([roomId])
  @@index([customerId])
  @@index([saleProfileId])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
}

model LeaseContractFile {
  id              String        @id @default(uuid())
  leaseContractId String
  fileName        String?
  fileUrl         String
  mimeType        String?
  size            Int?
  note            String?
  leaseContract   LeaseContract @relation(fields: [leaseContractId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([leaseContractId])
}

model LeaseContractChangeLog {
  id              String                    @id @default(uuid())
  leaseContractId String
  changedById     String?
  action          LeaseContractChangeAction
  beforeData      Json?
  afterData       Json?
  note            String?
  leaseContract   LeaseContract             @relation(fields: [leaseContractId], references: [id], onDelete: Cascade)
  changedBy       User?                     @relation("LeaseContractChangeChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt       DateTime                  @default(now())

  @@index([leaseContractId])
  @@index([changedById])
  @@index([action])
  @@index([createdAt])
}
