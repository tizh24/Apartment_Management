generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  SALE
}

enum RoomStatus {
  VACANT
  OCCUPIED
  RESERVED
  CHECKOUT_SOON
  MAINTENANCE
}

enum SaleContractStatus {
  ACTIVE
  COMPLETED
  CANCELED
}

enum CommissionStatus {
  UNPAID
  PAID
  CANCELED
}

model User {
  id                              String                  @id @default(uuid())
  username                        String                  @unique
  email                           String                  @unique
  fullName                        String
  passwordHash                    String
  role                            UserRole                @default(STAFF)
  apartmentId                     String?
  apartment                       Apartment?              @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  isActive                        Boolean                 @default(true)
  lastLoginAt                     DateTime?
  createdAt                       DateTime                @default(now())
  updatedAt                       DateTime                @updatedAt
  meterReadings                   MeterReading[]
  saleProfile                     SaleProfile?
  confirmedSaleCommissionPayments SaleCommissionPayment[] @relation("SaleCommissionPaymentConfirmedBy")

  @@index([apartmentId])
}

model Apartment {
  id            String         @id @default(uuid())
  shortId       String?        @unique
  name          String
  address       String?
  note          String?
  timezone      String         @default("Asia/Bangkok")
  rooms         Room[]
  users         User[]
  saleContracts SaleContract[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Room {
  id            String         @id @default(uuid())
  shortId       String?        @unique
  apartmentId   String
  code          String
  floor         String?
  area          Decimal?       @db.Decimal(10, 2)
  monthlyRent   Decimal        @db.Decimal(10, 2)
  description   String?
  amenities     String[]       @default([])
  imageUrls     String[]       @default([])
  status        RoomStatus     @default(VACANT)
  note          String?
  apartment     Apartment      @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  meterReadings MeterReading[]
  saleContracts SaleContract[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([apartmentId, code])
}

model MeterReading {
  id                   String   @id @default(uuid())
  roomId               String
  periodStart          DateTime
  periodEnd            DateTime
  electricityStart     Decimal  @db.Decimal(10, 2)
  electricityEnd       Decimal  @db.Decimal(10, 2)
  electricityUsage     Decimal  @db.Decimal(10, 2)
  electricityUnitPrice Decimal  @db.Decimal(10, 2)
  waterStart           Decimal  @db.Decimal(10, 2)
  waterEnd             Decimal  @db.Decimal(10, 2)
  waterUsage           Decimal  @db.Decimal(10, 2)
  waterUnitPrice       Decimal  @db.Decimal(10, 2)
  totalAmount          Decimal  @db.Decimal(10, 2)
  recordedById         String?
  note                 String?
  room                 Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  recordedBy           User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([roomId, periodStart, periodEnd])
  @@index([roomId, periodStart])
  @@index([recordedById])
}

model SaleProfile {
  id                 String                  @id @default(uuid())
  userId             String?                 @unique
  fullName           String
  phoneNumber        String
  bankAccountNumber  String
  bankName           String
  bankCode           String?
  note               String?
  isActive           Boolean                 @default(true)
  user               User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  contracts          SaleContract[]
  commissionPayments SaleCommissionPayment[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([fullName])
  @@index([phoneNumber])
}

model SaleContract {
  id               String                      @id @default(uuid())
  contractCode     String                      @unique
  saleId           String
  apartmentId      String?
  roomId           String?
  customerName     String
  customerPhone    String?
  startDate        DateTime
  endDate          DateTime?
  contractValue    Decimal                     @db.Decimal(12, 2)
  commissionAmount Decimal                     @db.Decimal(12, 2)
  contractStatus   SaleContractStatus          @default(ACTIVE)
  commissionStatus CommissionStatus            @default(UNPAID)
  commissionPaidAt DateTime?
  note             String?
  sale             SaleProfile                 @relation(fields: [saleId], references: [id], onDelete: Restrict)
  apartment        Apartment?                  @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  room             Room?                       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  paymentItems     SaleCommissionPaymentItem[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([saleId])
  @@index([apartmentId])
  @@index([roomId])
  @@index([startDate])
  @@index([contractStatus])
  @@index([commissionStatus])
}

model SaleCommissionPayment {
  id             String                      @id @default(uuid())
  saleId         String
  totalAmount    Decimal                     @db.Decimal(12, 2)
  paymentQrUrl   String?
  paymentContent String
  confirmedById  String?
  paidAt         DateTime                    @default(now())
  note           String?
  sale           SaleProfile                 @relation(fields: [saleId], references: [id], onDelete: Restrict)
  confirmedBy    User?                       @relation("SaleCommissionPaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  items          SaleCommissionPaymentItem[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([saleId])
  @@index([confirmedById])
  @@index([paidAt])
}

model SaleCommissionPaymentItem {
  paymentId      String
  saleContractId String
  amount         Decimal               @db.Decimal(12, 2)
  payment        SaleCommissionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  saleContract   SaleContract          @relation(fields: [saleContractId], references: [id], onDelete: Restrict)

  @@id([paymentId, saleContractId])
  @@unique([saleContractId])
}
